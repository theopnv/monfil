{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node", "electron"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "test/e2e/**/*.ts",
    "eslint.config.ts",
    "forge.config.ts",
    "forge.env.d.ts",
    "playwright.config.ts",
    "vite.main.config.mts",
    "vite.preload.config.mts",
    "vite.renderer.config.mts",
    "vitest.browser.config.mts",
    "vitest.config.mts"
  ]
}
