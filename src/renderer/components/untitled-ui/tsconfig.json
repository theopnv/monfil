{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    // Untitled UI's CLI generates components against a standard strict
    // template, not this project's additional exactOptionalPropertyTypes.
    // Vendored files intentionally pass `undefined` to optional Aria props
    // when omitting them conditionally, which that flag forbids.
    "exactOptionalPropertyTypes": false,

    // Project reference: makes this folder its own TS Program with its own
    // rules. The renderer project consumes only the emitted .d.ts, so importing
    // app code never re-checks this source under the root's stricter
    // settings (which a plain tsconfig `exclude` can't do — TS shares one
    // rule set across any files pulled into the same connected Program).
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../../../../src/renderer/*"]
    },
    "declaration": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../../../dist/untitled-ui-types"
  },
  "include": ["**/*"],
  "exclude": []
}
