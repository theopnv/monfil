{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "monfil-docs",
	"compatibility_date": "2026-10-30",
	"build": {
		"command": "rm -rf deploy && mkdir deploy && cp -r dist deploy/docs"
	},
	"assets": {
		"directory": "./deploy",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "monfil.app/docs*", "zone_name": "monfil.app" }]
}
