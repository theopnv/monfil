{
  "name": "monfil",
  "productName": "monfil",
  "version": "0.10.0",
  "description": "RSS feed reader and more.",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "lint": "tsc -b . && eslint --ext .ts,.tsx . && npm run lint:deps",
    "lint:deps": "depcruise src",
    "lint:docs": "markdownlint-cli2 \"README.md\" \"CONTRIBUTING.md\" \"doc/src/content/docs/**/*.{md,mdx}\"",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest --run --project node",
    "test:integration": "vitest --run --project browser",
    "pretest:e2e": "npm run package",
    "test:e2e": "npx playwright test",
    "coverage:vitest": "vitest --run --coverage --reporter=default --reporter=html",
    "coverage:merge": "node scripts/coverage/merge.mts",
    "coverage:ingest": "node scripts/coverage/ingest.mts",
    "coverage:report": "node scripts/coverage/report.mts",
    "coverage:backfill": "node scripts/coverage/backfill.mts",
    "mutate": "node scripts/mutation/run.mts",
    "mutate:worklist": "node scripts/mutation/worklist-cli.mts",
    "mutate:upload": "node --env-file-if-exists=.env scripts/mutation/dashboard-cli.mts",
    "check:feedpacks": "node scripts/check-feedpacks.mjs",
    "complexity": "node scripts/complexity/index.mts",
    "complexity:report": "node scripts/complexity/report.mts",
    "complexity:ingest": "node scripts/complexity/ingest.mts",
    "complexity:backfill": "node scripts/complexity/backfill.mts",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "release": "semantic-release",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": {
    "name": "theopnv",
    "email": "22332931+theopnv@users.noreply.github.com"
  },
  "license": "BUSL-1.1",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-forge/cli": "^8.0.1",
