{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "electron-forge: start (debug)",
      "type": "shell",
      "command": "${workspaceFolder}/node_modules/.bin/electron-forge",
      "windows": {
        "command": "${workspaceFolder}/node_modules/.bin/electron-forge.cmd"
      },
      "args": ["start", "--inspect-electron", "--", "--remote-debugging-port=9222"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^ZZZZZ_NO_MATCH_ZZZZZ$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Checking your system",
          "endsPattern": "DevTools listening on"
        }
      }
    }
  ]
}
